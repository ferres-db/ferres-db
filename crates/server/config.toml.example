# Configuração do FerresDB Server
# Copie este arquivo para config.toml e ajuste conforme necessário
# Variáveis de ambiente têm precedência sobre este arquivo

host = "0.0.0.0"
port = 3000
storage_path = "./data"
log_level = "info"

# API Keys (separadas por vírgula)
# Gere keys com: openssl rand -hex 32
# api_keys = "sk-dev-abc123,sk-prod-xyz789"

