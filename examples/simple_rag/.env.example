# Copie para .env e preencha as chaves.
# cp .env.example .env

# FerresDB (padrão: http://localhost:8080 - configurável via --server)
# FERRES_SERVER=http://localhost:8080

# OpenAI (obrigatório para --embedding openai e --llm openai)
OPENAI_API_KEY=sk-...

# Anthropic (obrigatório para --llm anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Cohere (opcional; --embedding cohere na ingestão ou --reranker cohere)
# COHERE_API_KEY=...
