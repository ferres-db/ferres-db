# Copie para .env e ajuste conforme necessário:
#   copy .env.docker.example .env   (Windows)
#   cp .env.docker.example .env    (Linux/Mac)

# Porta do backend (API) no host
BACKEND_PORT=8080

# Porta do frontend (dashboard) no host
FRONTEND_PORT=3000

# Nível de log do backend: trace, debug, info, warn, error
LOG_LEVEL=info

# Caminho dos dados dentro do container (volume)
STORAGE_PATH=/data

# --- Frontend (dashboard): config em RUNTIME (docker run) ---
# URL da API no browser. Passe ao rodar o container: -e VITE_API_BASE_URL=...
VITE_API_BASE_URL=http://localhost:8080
# API key (opcional): -e VITE_API_KEY=sk-...

# --- Backend: config em RUNTIME (docker run) ---
# Origens CORS permitidas (vírgula). Ex.: -e CORS_ORIGINS=https://app.seudominio.com
# CORS_ORIGINS=
