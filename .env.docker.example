# Copie para .env e ajuste conforme necessário:
#   copy .env.docker.example .env   (Windows)
#   cp .env.docker.example .env    (Linux/Mac)

# Porta do backend (API) no host
BACKEND_PORT=8080

# Porta do frontend (dashboard) no host
FRONTEND_PORT=3000

# Nível de log do backend: trace, debug, info, warn, error
LOG_LEVEL=info

# Caminho dos dados dentro do container (volume)
STORAGE_PATH=/data

# URL da API usada pelo frontend no browser (build-time).
# Use o host e a porta que o usuário acessa (ex.: se BACKEND_PORT=9090, use :9090).
VITE_API_BASE_URL=http://localhost:8080

# API key (opcional) para o frontend
# VITE_API_KEY=
